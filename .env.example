# ---------------------------------------------------------------------------
# Portfolio Rebalancer configuration
# Copy this file to `.env.local` and adjust as needed.
# ---------------------------------------------------------------------------

# DATABASE
# ---------
# By default the app uses a LOCAL SQLite file at ./data/portfolio.db.
# You do NOT need to set anything for local development.
#
# To deploy on Vercel (or any serverless host with an ephemeral filesystem),
# provision a free Turso database (https://turso.tech) and set BOTH vars below.
# When TURSO_DATABASE_URL is present, the app uses Turso instead of the file.
#
# TURSO_DATABASE_URL="libsql://your-db-name-you.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional: override the local sqlite file path (ignored when Turso is used).
# LOCAL_DB_PATH="./data/portfolio.db"

# AI VISION (optional) — accurate image extraction
# --------------------------------------------------------------
# The default image reader is FREE local OCR (tesseract, in-browser). For much
# higher accuracy, set ONE vision API key below and an "AI Vision" toggle
# appears. Images are sent to the provider only when you pick that engine; the
# key stays server-side and is never exposed to the browser.
#
# Provider is auto-selected by whichever key is present (Gemini preferred).
# Set VISION_PROVIDER=gemini|claude to force one if both keys exist.
# VISION_PROVIDER="gemini"

# --- Google Gemini (has a free tier) ---
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional: override the model. Defaults to the rolling alias gemini-flash-latest.
# If that (or your override) isn't available to your key, the app auto-discovers
# a supported vision model from your account and retries.
# GEMINI_MODEL="gemini-flash-latest"

# --- Anthropic Claude (paid) ---
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional: defaults to claude-sonnet-5.
# ANTHROPIC_MODEL="claude-sonnet-5"

# LIVE PRICES (optional)
# ----------------------
# Best-effort live price fetch from the PSX data portal. If it fails or is
# disabled, the app falls back to prices extracted from your portfolio image
# or entered manually. Set to "false" to skip live fetching entirely.
ENABLE_LIVE_PSX_PRICES="true"

# AUTHENTICATION (required for multi-user)
# ----------------------------------------
# Generate a random secret, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Initial admin account (created on first DB init if password is set).
# This user is both admin (can open /admin) and a normal user with their own portfolios.
ADMIN_EMAIL="anasm51006@gmail.com"
ADMIN_INITIAL_PASSWORD="choose-a-strong-password"
